<layouts xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- A generic, centered layout. -->
    <layout id="MainLayout">
        <label id="value" x="center" y="center" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_CENTER" font="Graphics.FONT_NUMBER_HOT" />
        <label id="label" x="center" y="80%" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_CENTER" font="Graphics.FONT_LARGE" />
    </layout>

    <!-- Layouts used for the for the four quadrants. -->
    <layout id="TopLeftLayout">
        <label id="value" x="95" y="42" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_RIGHT" font="Graphics.FONT_LARGE" />
        <label id="label" x="95" y="75" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_RIGHT" font="Graphics.FONT_TINY" />
    </layout>
    <layout id="TopRightLayout">
        <label id="value" x="14" y="42" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_LEFT" font="Graphics.FONT_LARGE" />
        <label id="label" x="14" y="75" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_LEFT" font="Graphics.FONT_TINY" />
    </layout>
    <layout id="BottomLeftLayout">
        <label id="value" x="95" y="27" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_RIGHT" font="Graphics.FONT_LARGE" />
        <label id="label" x="95" y="10" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_RIGHT" font="Graphics.FONT_TINY" />
    </layout>
    <layout id="BottomRightLayout">
        <label id="value" x="14" y="27" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_LEFT" font="Graphics.FONT_LARGE" />
        <label id="label" x="14" y="10" color="0x00D4FF" justification="Graphics.TEXT_JUSTIFY_LEFT" font="Graphics.FONT_TINY" />
    </layout>
</layouts>
